+static bool guest_read_implies_exec;
+
+void target_set_read_implies_exec(bool on, const char *image_name)
+{
+    guest_read_implies_exec = on;
+    if (on && guest_plog_on()) {
+        guest_plog("личность READ_IMPLIES_EXEC: у программы %s нет PT_GNU_STACK — "
+                   "читаемые страницы (куча, анонимные и файловые отображения) "
+                   "исполняемы, как у ядра ARM", image_name);
+    }
+}
+
+static inline int guest_rie_prot(int prot)
+{
+    if (guest_read_implies_exec && (prot & PROT_READ)) {
+        prot |= PROT_EXEC;
+    }
+    return prot;
+}
