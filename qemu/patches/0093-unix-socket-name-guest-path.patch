+/*
+ * ★ Патч 0093: имя сокета UNIX гостю — гостевым путём.
+ *
+ * Сокеты служб гостя (`/dev/socket/zygote` и прочие) стенд заводит у себя:
+ * хозяин видит их под корнем дерева, `<корень>/dev/socket/zygote`. Путь при
+ * bind и connect уводится под корень (патч 0063), а ответы getsockname,
+ * getpeername и accept отдавали гостю ХОЗЯЙСКИЙ путь как есть. Зигота 7.x
+ * перед ветвлением сверяет имена всех своих сокетов с белым списком
+ * (`/dev/socket/zygote`…) и на хозяйском имени умирает целиком:
+ *   E Zygote: Socket name not whitelisted : <корень>/dev/socket/zygote (fd=3)
+ *   F art: … Zygote.cpp:467: Unable to construct file descriptor table.
+ * Теперь путь под корнем дерева (или общей папкой) переводится обратно тем
+ * же path_to_guest, что и цели ссылок; безымянные и абстрактные — как были.
+ * Длина — как у ядра: семейство, путь и завершающий ноль.
+ */
+static socklen_t unix_name_to_guest(void *addr, socklen_t len)
+{
+    struct sockaddr_un *un = addr;
+    size_t off = offsetof(struct sockaddr_un, sun_path);
+    char host[sizeof(un->sun_path) + 1];
+    char *g;
+    size_t n;
 
+    if (len <= off || un->sun_family != AF_UNIX || un->sun_path[0] == '\0') {
+        return len;
+    }
+    n = MIN(len - off, sizeof(un->sun_path));
+    memcpy(host, un->sun_path, n);
+    host[n] = '\0';
+    g = path_to_guest(host);
+    if (!g) {
+        return len;
+    }
+    n = MIN(strlen(g), sizeof(un->sun_path) - 1);
+    memcpy(un->sun_path, g, n);
+    un->sun_path[n] = '\0';
+    g_free(g);
+    return off + n + 1;
+}
