Режим «init прошивки»: mknod символьного и блочного узла — заглушка (только при GUEST_FWINIT=1).

Симптом. Настоящий /init первым делом создаёт /dev/__null__ вызовом
mknod(S_IFCHR, 1:3) и без него выходит с кодом 1; ueventd и fs_mgr создают
узлы разделов и устройств. Хозяин узел устройства приложению не даст: нужно
право CAP_MKNOD, которого нет ни у приложения, ни у обычного пользователя.

Причина. Гостевой mknod шёл хозяину как есть.

Решение. При GUEST_FWINIT=1 mknod и mknodat символьного и блочного узла делает
заглушка (qemu/src/guest_fwinit.c):
  1:3 null, 1:5 zero, 1:7 full, 1:8 random, 1:9 urandom — ссылка на хозяйский
      узел (его и так видно гостю), открывается и читается как настоящий;
  1:11 (журнал ядра, init пишет туда в /dev/__kmsg__) при заданном GUEST_KMSG —
      ссылка на этот файл стенда: журнал init остаётся целым, даже когда init
      удаляет имя узла;
  прочие — пустой обычный файл с правами из mode.
FIFO, сокеты и обычные файлы идут как прежде — настоящим mknod.

⚠️ Заглушка создаёт узел только под корнем гостя; путь вне дерева идёт
настоящему mknod. Файл GUEST_KMSG создаётся, если его ещё нет (init открывает
узел на запись без O_CREAT), и не усекается.
⚠️ GUEST_KMSG — абсолютный путь файла стенда: ссылка узла 1:11 указывает на него.
Относительное значение транслятор при старте процесса переписывает в абсолютное
от рабочего каталога хозяина (guest_fwinit.c, absolutize_paths); не вышло —
узел 1:11 станет обычным пустым файлом, висячей ссылки не будет.
⚠️ Узел, имя которого уже занято (стенд кладёт метку и пустые узлы разделов
заранее), не пересоздаётся: ответ EEXIST, процесс жив.
⚠️ Номер устройства у гостя — 32 бита (major<<8 | minor), знак не расширяется.
⚠️ Без GUEST_FWINIT=1 поведение ровно прежнее.

Проверка: tests/qemu/fwinit.sh, случаи «2».

--- a/linux-user/syscall.c
+++ b/linux-user/syscall.c
@@ -165,6 +165,7 @@
 #include "guest_fs.h"
 #include "guest_oom.h"
 #include "guest_script.h"
+#include "guest_fwinit.h"
 
 /*
  * ★ Отказ в смене владельца превращаем в успех.
@@ -10820,7 +10821,16 @@
     case TARGET_NR_mknod:
         if (!(p = lock_user_string(arg1)))
             return -TARGET_EFAULT;
-        ret = get_errno(mknod(path(p), arg2, arg3));
+        /*
+         * ★ Режим «init прошивки» (патч 0076): узел устройства — заглушка
+         * (guest_fwinit.c). Только при GUEST_FWINIT=1; без неё вызов настоящий.
+         * Номер устройства — 32 бита гостя, без знакового расширения.
+         */
+        if (guest_fwinit_node(arg2)) {
+            ret = get_errno(guest_fwinit_mknod(path(p), arg2, (abi_ulong)arg3));
+        } else {
+            ret = get_errno(mknod(path(p), arg2, arg3));
+        }
         unlock_user(p, arg1, 0);
         return ret;
 #endif
@@ -10828,7 +10838,13 @@
     case TARGET_NR_mknodat:
         if (!(p = lock_user_string(arg2)))
             return -TARGET_EFAULT;
-        ret = get_errno(mknodat(arg1, path_at(arg1, p), arg3, arg4));
+        /* ★ То же для mknodat (патч 0076). */
+        if (guest_fwinit_node(arg3)) {
+            ret = get_errno(guest_fwinit_mknod(path_at(arg1, p), arg3,
+                                               (abi_ulong)arg4));
+        } else {
+            ret = get_errno(mknodat(arg1, path_at(arg1, p), arg3, arg4));
+        }
         unlock_user(p, arg2, 0);
         return ret;
 #endif
