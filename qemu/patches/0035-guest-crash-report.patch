 {
@@ -770,6 +770,19 @@
             target_sig, strsignal(host_sig), "core dumped" );
     }
 
+    /* ★ Отчёт о падении гостя — до выхода, пока состояние ещё цело. */
+    fprintf(stderr, "qemu: ★ гость упал, сигнал %d (%s); состояние процессора:\n",
+            target_sig, strsignal(host_sig));
+    cpu_dump_state(cpu, stderr, 0);
+#ifdef TARGET_ARM
+    /* ⚠️ У Thumb младший бит адреса — признак режима, а не часть адреса. */
+    guest_addr_bytes("LR", (unsigned long)env->regs[14] & ~1UL, 16, 6);
+    guest_addr_bytes("PC", (unsigned long)env->regs[15] & ~1UL, 0, 14);
+    guest_addr_where("PC", (unsigned long)env->regs[15]);
+    guest_addr_where("LR", (unsigned long)env->regs[14]);
+#endif
+    fflush(stderr);
+
     preexit_cleanup(env, 128 + target_sig);
     die_with_signal(host_sig);
 }
