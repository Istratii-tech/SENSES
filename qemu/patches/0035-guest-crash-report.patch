--- a/linux-user/signal.c	2026-09-05 17:23:43.825495178 +0300
+++ b/linux-user/signal.c	2026-09-05 17:23:43.826495178 +0300
@@ -737,6 +737,92 @@
     _exit(EXIT_FAILURE);
