+     * подложные записи /proc.
+     */
+    fd = memfd_create("qemu-cmdline", 0);
+    if (fd < 0) {
+        char tmp[1024];
+        const char *tmpdir = getenv("TMPDIR");
+
+        if (!tmpdir) {
+            tmpdir = "/tmp";
+        }
+        snprintf(tmp, sizeof tmp, "%s/qemu-cmdline.XXXXXX", tmpdir);
+        fd = mkstemp(tmp);
+        if (fd < 0) {
+            return 0;
+        }
+        unlink(tmp);
+    }
+    if (write(fd, res, used) != (ssize_t)used || lseek(fd, 0, SEEK_SET) != 0) {
+        close(fd);
+        return 0;
+    }
+    *out = fd;
+    return 1;
