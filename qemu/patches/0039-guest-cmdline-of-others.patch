+    if (end == pathname + 6 || strcmp(end, "/cmdline") != 0 || pid <= 0) {
+        return 0;
+    }
+    if (pid == (long)getpid()) {
+        return 0;               /* своё отдаёт open_self_cmdline — он точнее */
+    }
