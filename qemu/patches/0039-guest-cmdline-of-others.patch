+         * Не наш гость (или форма изменилась). Хозяйские пути всё равно не
+         * показываем: отдаём одно короткое имя файла.
+         */
+        const char *slash = strrchr(tok[0], '/');
+        const char *name = slash ? slash + 1 : tok[0];
+        size_t len = strlen(name);
+
+        if (len >= sizeof res) {
+            len = sizeof res - 1;
+        }
+        memcpy(res, name, len);
+        res[len] = 0;
+        used = len + 1;
+    } else {
+        size_t len = strlen(prog);
+
+        if (len + 1 > sizeof res) {
+            return 0;
+        }
+        memcpy(res, prog, len + 1);
+        used = len + 1;
+        for (i = first; i < ntok; i++) {
+            len = strlen(tok[i]);
+            if (used + len + 1 > sizeof res) {
+                break;
+            }
+            memcpy(res + used, tok[i], len + 1);
+            used += len + 1;
+        }
+    }
