+    snprintf(host, sizeof host, "/proc/%ld/cmdline", pid);
+    fd = open(host, O_RDONLY);
+    if (fd < 0) {
+        return 0;               /* нет процесса — пусть отвечает ядро */
+    }
+    n = (int)read(fd, buf, sizeof buf - 1);
+    close(fd);
+    if (n <= 0) {
+        return 0;
+    }
+    buf[n] = 0;
+
+    /* Доводы в /proc/<pid>/cmdline разделены нулями. */
+    for (i = 0; i < n && ntok < (int)(sizeof tok / sizeof tok[0]); ) {
+        tok[ntok++] = buf + i;
+        while (i < n && buf[i]) {
+            i++;
+        }
+        i++;
+    }
+    if (ntok == 0) {
+        return 0;
+    }
+
+    /* Наша форма запуска: … -L <корень> … -0 <программа> … */
+    for (i = 0; i + 1 < ntok; i++) {
+        if (strcmp(tok[i], "-L") == 0 && !root) {
+            root = tok[i + 1];
+        } else if (strcmp(tok[i], "-0") == 0 && !prog) {
+            prog = tok[i + 1];
+        }
+    }
+
+    if (root && prog) {
+        /*
