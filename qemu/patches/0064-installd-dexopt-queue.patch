+                }
+                return fd;
+            }
+            close(fd);
+        }
+        if (++waited > 6000) {
+            fprintf(stderr, "qemu: очередь installd: 10 минут без гнезда — иду без очереди\n");
+            return -1;
+        }
+        g_usleep(100 * 1000);
+    }
+}
