+            snprintf(name, sizeof name, "%s/forkslot.%d", dir, k);
+            fd = open(name, O_RDWR | O_CREAT, 0600);
+            if (fd < 0) {
+                return -1;              /* некуда класть гнёзда — без очереди */
+            }
+            if (flock(fd, LOCK_EX | LOCK_NB) == 0) {
+                if (waited >= 10) {
