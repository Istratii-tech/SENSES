★★★ Опыт: выключатель оптимизатора переводов целиком (GUEST_NO_TCGOPT).

Отладочный, по умолчанию выключен. Разбор — в комментарии у места правки.

--- a/tcg/tcg.c
+++ b/tcg/tcg.c
@@ -54,6 +54,9 @@
 #include "exec/log.h"
 #include "tcg/tcg-ldst.h"
 #include "tcg/tcg-temp-internal.h"
+
+/* ★ Выключатель оптимизатора — linux-user/guest_pagelog.c, см. tcg_optimize. */
+int guest_no_tcgopt(void);
 #include "tcg-internal.h"
 #include "accel/tcg/perf.h"
 #ifdef CONFIG_USER_ONLY
@@ -6063,7 +6066,27 @@
     }
 #endif
 
-    tcg_optimize(s);
+    /*
+     * ★★★ GUEST_NO_TCGOPT: выключить оптимизатор переводов целиком.
+     *
+     * Опыт, не лечение. Движок JavaScript порождает команду перехода со
+     * смещением 0x2000908 там, где должно быть маленькое смещение внутри той
+     * же функции: лишним оказывается ровно один разряд (25-й). Это похоже на
+     * НЕВЕРНО ВЫЧИСЛЕННОЕ ЧИСЛО, а не на испорченную память — всё остальное в
+     * объекте кода цело, и он байт в байт совпадает у разных процессов.
+     *
+     * Одну такую ошибку в оптимизаторе qemu мы уже нашли и закрыли переходом
+     * на 8.2.4 («tcg/optimize: Fix sign_mask for logical right-shift»,
+     * заявка qemu #2248) — не вылечило. Этот ключ проверяет весь оптимизатор
+     * разом: если с ним падения нет, ошибка там, и её надо искать дальше;
+     * если есть — оптимизатор ни при чём.
+     *
+     * ⚠️ Стенд с этим ключом заметно медленнее: переводы выходят длиннее и
+     * глупее. Для одной проверки это терпимо.
+     */
+    if (!guest_no_tcgopt()) {
+        tcg_optimize(s);
+    }
 
     reachable_code_pass(s);
     liveness_pass_0(s);
