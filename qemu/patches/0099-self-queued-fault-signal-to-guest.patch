+/*
+ * ★★★★★ Р-149: сигнал, который гость ставит в очередь САМ СЕБЕ с кодом > 0.
+ *
+ * Обработчик падения bionic 7.x (linker/debugger.cpp, debuggerd_signal_handler)
+ * после доклада ставит SIG_DFL и посылает себе тот же сигнал вызовом
+ * rt_tgsigqueueinfo с ИСХОДНЫМ siginfo — код у него положительный
+ * (SEGV_MAPERR = 1). Ядро разрешает положительный код только самому себе (с
+ * 3.9: rt_tgsigqueueinfo — своему потоку, rt_sigqueueinfo — своему tid), и
+ * сигнал ждёт в очереди, пока его не откроет маска.
+ *
+ * Транслятор отдавал такой вызов хозяину. Хозяин доставлял SIGSEGV с кодом 1
+ * самому транслятору, а host_signal_handler по коду > 0 считает сигнал СВОИМ
+ * отказом памяти: места в переведённом коде не находит и умирает —
+ *
+ *   qemu-arm: QEMU internal SIGSEGV {code=MAPERR, addr=0}
+ *
+ * Гость не получал ни своего обработчика, ни отчёта транслятора о падении
+ * гостя (регистры, место — патч 0035): композитор 7.1.2 (Р-149) умирал без
+ * следа, где именно. SIGILL, SIGFPE и SIGTRAP с кодом > 0 хозяин и вовсе
+ * считает «ошибкой хозяина» сразу, SIGBUS — так же, как SIGSEGV.
+ *
+ * Здесь вызов к себе с таким сигналом хозяину НЕ отдаётся: транслятор ставит
+ * сигнал в очередь гостя сам — туда же и так же, как ставит её асинхронный
+ * сигнал хозяина (host_signal_handler: sigtab, signal_pending), с siginfo
+ * гостя (поля — как их разобрал бы тот путь: код > 0 → вид QEMU_SI_RT). Дальше
+ * — как у ядра в главном: process_pending_signals уважает маску гостя, обработчик
+ * гостя получает тот же код и адрес, а при SIG_DFL — отчёт о падении ГОСТЯ
+ * (dump_core_and_abort) и смерть от того же сигнала.
+ *
+ * ⚠️ Обычный (не RT) сигнал у ядра не копится: второй такой же, пока первый
+ * ждёт, пропадает (legacy_queue) — так и здесь.
+ * ⚠️ Расхождения, пока сигнал ждёт в sigtab: rt_sigpending и rt_sigtimedwait
+ * гостя QEMU отдаёт хозяину — ждущего сигнала они не видят (ядро видит); а
+ * sigaction(SIG_IGN) ждущий не снимает (ядро снимает) — он отбрасывается лишь
+ * на доставке. Случаи крайние: обработчику падения bionic они не нужны.
+ * ⚠️ Сигнал процессу (rt_sigqueueinfo) ядро отдало бы любому потоку, который
+ * его не закрыл; здесь он всегда у зовущего потока (ядро тоже берёт его первым,
+ * если тот сигнал не закрыл).
+ * ⚠️ Прочие вызовы — чужим процессам и потокам, сигналы не из пяти, код ≤ 0 —
+ * идут к хозяину как прежде: там хозяйский путь не путается (код ≤ 0
+ * host_signal_handler понимает как присланный, а положительный код чужим ядро
+ * отвергает EPERM).
+ */
+bool guest_sigqueue_inside(int host_sig, int si_code)
+{
+    if (si_code <= 0) {
+        return false;
+    }
+    switch (host_sig) {
+    case SIGSEGV:
+    case SIGBUS:
+    case SIGILL:
+    case SIGFPE:
+    case SIGTRAP:
+        return true;
+    }
+    return false;
+}
+
+abi_long guest_sigqueue_self(CPUArchState *env, int target_sig,
+                             const target_siginfo_t *uinfo)
+{
+    TaskState *ts = env_cpu(env)->opaque;
+    struct emulated_sigtable *k;
+    abi_ulong sival;
+    int code;
+
+    if (target_sig < 1 || target_sig > TARGET_NSIG) {
+        return -TARGET_EINVAL;
+    }
+    /* Сигналы хозяина закрыты до process_pending_signals: sigtab не делим с host_signal_handler. */
+    if (block_signals()) {
+        return -QEMU_ERESTARTSYS;
+    }
+    k = &ts->sigtab[target_sig - 1];
+    if (k->pending) {
+        return 0;
+    }
+    __get_user(code, &uinfo->si_code);
+    memset(&k->info, 0, sizeof(k->info));
+    k->info.si_signo = target_sig;
+    __get_user(k->info.si_errno, &uinfo->si_errno);
+    __get_user(k->info._sifields._rt._pid, &uinfo->_sifields._rt._pid);
+    __get_user(k->info._sifields._rt._uid, &uinfo->_sifields._rt._uid);
+    __get_user(sival, &uinfo->_sifields._rt._sigval.sival_ptr);
+    k->info._sifields._rt._sigval.sival_ptr = sival;
+    k->info.si_code = deposit32(code, 16, 16, QEMU_SI_RT);
+    k->pending = target_sig;
+    return 0;
+}
+
