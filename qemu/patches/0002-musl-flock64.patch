Сборка linux-user на musl: нет ни flock64, ни off64_t, ни pread64/pwrite64.

musl 1.2.4 убрал из заголовков ВСЮ группу LFS64 (`off64_t`, `pread64`,
`pwrite64`, `_LARGEFILE64_SOURCE`): у него off_t 64-битная всегда, отдельные
имена не нужны. Точно так же нет ни `struct flock64`, ни `F_GETLK64`/`F_SETLK64`/`F_SETLKW64`:
на 64-битном хозяине `struct flock` уже 64-битная, а отдельных команд fcntl для
неё не нужно — ядро принимает обычные. glibc держит их как исторические
синонимы, и qemu 8.2 пользуется именно ими, поэтому на musl файл не собирается
(37 ошибок в linux-user/syscall.c).

Патч нужен только для сборки под АНДРОИД: там наш qemu-arm обязан быть
статическим (bionic чужой линкер не даст), а статическую libglib даёт из
дистрибутивов только Alpine — то есть musl.

⚠️ `#define flock64 flock` переименовывает ИМЕННО тег структуры: имена вида
copy_from_user_flock64 — единые лексемы и препроцессором не затрагиваются.

--- a/linux-user/syscall.c
+++ b/linux-user/syscall.c
@@ -128,6 +128,26 @@
 #include "linux_loop.h"
 #include "uname.h"
 
+/*
+ * musl: 64-битные варианты блокировок не объявлены — на 64-битном хозяине
+ * обычные уже 64-битные. Подставляем их, иначе linux-user не собирается.
+ */
+#ifndef F_GETLK64
+#define F_GETLK64  F_GETLK
+#define F_SETLK64  F_SETLK
+#define F_SETLKW64 F_SETLKW
+#define flock64    flock
+#endif
+#ifndef __GLIBC__
+/* musl: группа LFS64 убрана из заголовков — off_t и так 64-битная. */
+#define off64_t  off_t
+#define pread64  pread
+#define pwrite64 pwrite
+#define lseek64  lseek
+#define ftruncate64 ftruncate
+#define truncate64  truncate
+#endif
+
 #include "qemu.h"
 #include "user-internals.h"
 #include "strace.h"
