+/*
+ * ★ Журналы гостя открываются с ДОЗАПИСЬЮ, что бы ни просил гость.
+ *
+ * У нас /dev/log/main — обычный файл, а не кольцевой буфер драйвера. Каждый
+ * гостевой процесс открывает его сам и получает СВОЁ смещение с нуля, поэтому
+ * записи зиготы ложились поверх записей SurfaceFlinger и наоборот. Пока
+ * процесс был один, это не мешало; на Э3 их сразу четыре, и первое же, что
+ * пропало, — стек падения system_server, ради которого лог и читают.
+ *
+ * O_APPEND решает это целиком: ядро само ставит смещение в конец под тем же
+ * замком, что и запись. Настоящий сборщик логов отдельным демоном
+ * когда-нибудь понадобится ради отметок времени и разделения буферов, но
+ * от потери записей спасает уже это.
+ */
+static int guest_log_open_flags(const char *pathname, int flags)
+{
+    if (pathname && strncmp(pathname, "/dev/log/", 9) == 0 &&
+        (flags & O_ACCMODE) != O_RDONLY) {
+        flags |= O_APPEND;
+    }
+    return flags;
+}
