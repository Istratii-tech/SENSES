+    /*
+     * ★ Сперва — то, что гость назначил сам (карта выше). Это важнее нашего
+     * правила: PackageManagerService сверяет владельца каталога данных с uid
+     * пакета, и без карты он видел бы root и ругался «System UIDs Inconsistent».
+     */
+    {
+        uint32_t ou, og;
+        if (guest_own_get(st->st_dev, st->st_ino, &ou, &og)) {
+            st->st_uid = ou;
+            st->st_gid = og;
+            return;
+        }
+    }
     if (st->st_uid == me) {
         st->st_uid = 0;
     }
