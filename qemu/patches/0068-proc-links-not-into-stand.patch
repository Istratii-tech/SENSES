+static ssize_t guest_exe_of_other(const char *pathname, char *out, size_t cap)
+{
+    char host[64], buf[4096];
+    const char *tok[128], *root = NULL;
+    long pid;
+    char *end;
+    int fd, i, n, ntok = 0;
+    size_t rl;
+
+    if (!pathname || strncmp(pathname, "/proc/", 6) != 0) {
+        return 0;
+    }
+    pid = strtol(pathname + 6, &end, 10);
+    if (end == pathname + 6 || strcmp(end, "/exe") != 0 || pid <= 0 ||
+        pid == (long)getpid()) {
+        return 0;
+    }
+    snprintf(host, sizeof host, "/proc/%ld/cmdline", pid);
+    fd = open(host, O_RDONLY | O_CLOEXEC);
+    if (fd < 0) {
+        return 0;               /* нет процесса — пусть отвечает ядро */
+    }
+    n = (int)read(fd, buf, sizeof buf - 1);
+    close(fd);
+    if (n <= 0) {
+        return -EACCES;
+    }
+    buf[n] = 0;
+    for (i = 0; i < n && ntok < (int)ARRAY_SIZE(tok); ) {
+        tok[ntok++] = buf + i;
+        while (i < n && buf[i]) {
+            i++;
+        }
+        i++;
+    }
+    for (i = 0; i + 1 < ntok; i++) {
+        if (strcmp(tok[i], "-L") == 0) {
+            root = tok[i + 1];
+            break;
+        }
+    }
+    if (!root || !root[0]) {
+        return -EACCES;
+    }
+    rl = strlen(root);
+    for (i = 0; i < ntok; i++) {
+        if (strncmp(tok[i], root, rl) == 0 && tok[i][rl] == '/') {
+            size_t len = strlen(tok[i] + rl);
+
+            if (len > cap) {
+                len = cap;
+            }
+            memcpy(out, tok[i] + rl, len);
+            return (ssize_t)len;
+        }
+    }
+    return -EACCES;
+}
