+        if (prep < 0) {
+            return -host_to_target_errno(errno);
+        }
+        if (prep == 1) {
+            afd = rfd;
+        } else if (prep == 2) {
+            host_flags = (host_flags & ~MAP_TYPE) | MAP_PRIVATE;
+        }
+        mret = get_errno(target_mmap(addr, len, prot, host_flags, afd, offset));
+        if (afd != fd) {
+            close(afd);
+        }
+        if (!is_error(mret)) {
+            if (host_flags & MAP_FIXED) {
+                guest_ashmem_range_forget((abi_ulong)mret, (abi_ulong)len);
+            }
+            if (prep == 2 || prep == 3) {
+                guest_ashmem_range_note((abi_ulong)mret, (abi_ulong)len);
+            }
+        }
+        return mret;
+    }
 }
 
