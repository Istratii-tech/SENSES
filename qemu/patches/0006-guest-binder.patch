     };
+
+    /*
+     * ★ Гостевой /dev/binder — наш: за ним стоит binderd в юзерспейсе, а не
+     * драйвер ядра. Отдавать гостю ХОЗЯЙСКИЙ /dev/binder нельзя ни в каком
+     * виде: на телефоне он существует, и гостевой ProcessState начинал
+     * говорить с ним 32-битными структурами.
+     */
+    {
+        int bfd;
+
+        if (guest_binder_try_open(fname, &bfd)) {
+            return bfd < 0 ? -host_to_target_errno(errno) : bfd;
+        }
+    }
 
     /* if this is a file from /proc/ filesystem, expand full name */
     proc_name = realpath(fname, NULL);
@@ -9119,6 +9162,9 @@
         return get_errno(pidfd_getfd(arg1, arg2, arg3));
 #endif
     case TARGET_NR_close:
+        /* ★ Демон должен узнать о закрытии сессии: он разошлёт извещения о
