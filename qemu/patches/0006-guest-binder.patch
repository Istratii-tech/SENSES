 #include "qemu/guest-random.h"
 #include "qemu/selfmap.h"
+#include "guest_binder.h"
 #include "user/syscall-trace.h"
 #include "special-errno.h"
 #include "qapi/error.h"
@@ -5580,6 +5581,22 @@
