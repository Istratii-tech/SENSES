+     * нет вовсе.
+     *
+     * ⚠️ Приведение к uint32_t обязательно: номера вида 0xc0186201 в int
+     * отрицательны, и знаковое расширение до unsigned long дало бы
+     * 0xffffffffc0186201 — ни один case не совпал бы.
+     */
+    {
+        abi_long bret;
+
+        if (guest_binder_ioctl(fd, (unsigned long)(uint32_t)cmd, arg, &bret)) {
+            return bret < 0 ? -host_to_target_errno(errno) : bret;
+        }
+    }
+
     ie = ioctl_entries;
     for(;;) {
         if (ie->target_cmd == 0) {
@@ -5887,6 +5904,18 @@
 static abi_long do_mmap(abi_ulong addr, abi_ulong len, int prot,
                         int target_flags, int fd, off_t offset)
 {
+    /*
+     * ★ mmap на нашем binder: настоящий драйвер отображает сюда свои страницы
+     * для приёма транзакций, у нас это делает шим (см. guest_binder.c).
+     */
+    if (fd >= 0 && guest_binder_owns(fd)) {
+        abi_ulong baddr = 0;
+
+        if (guest_binder_mmap(fd, len, &baddr)) {
+            return baddr == (abi_ulong)-1 ? -TARGET_ENOMEM : (abi_long)baddr;
+        }
+    }
+
     /*
      * The historical set of flags that all mmap types implicitly support.
      */
@@ -8333,6 +8362,20 @@
 #endif
