Уже ловилось и лечилось раньше, на том же ядре 4.9.112 — грабля та же.

--- a/linux-user/signal.c	2026-09-01 23:21:26.718001203 +0300
+++ b/linux-user/signal.c	2026-09-01 23:21:26.718001203 +0300
@@ -1012,6 +1012,48 @@
     abi_ptr guest_addr = h2g_nocheck(host_addr);
     uintptr_t pc = host_signal_pc(uc);
     bool is_write = host_signal_write(info, uc);
+
+    /*
+     * ★★★ Если право записи сняли МЫ САМИ — отказ доступа может быть только
+     * записью, и разбирать хозяйский сигнал незачем.
+     *
+     * Как qemu следит за самомодифицирующимся кодом: у страницы, откуда уже
+     * оттранслирован код, снимается право записи (PAGE_WRITE гасится, а
+     * PAGE_WRITE_ORG остаётся). Гостевая запись туда приходит ошибкой доступа,
+     * qemu её узнаёт, сбрасывает перевод, возвращает право и повторяет запись.
+     * Гость об этом даже не знает.
+     *
+     * Узнаёт он её через host_signal_write(): на aarch64 тот читает ESR из
+     * рамки сигнала, а если записи ESR нет — разбирает инструкцию хозяина.
+     * ⚠️ На ядрах до 4.10 записи ESR в рамке НЕТ ВОВСЕ, и запасной разбор тоже
+     * срабатывает не всегда. Тогда запись считается чтением, страница не
+     * открывается, и SIGSEGV уходит ГОСТЮ — то есть гость убивается за то, что
+     * написал в свою же законно доступную для записи память.
+     *
+     * Так умирал браузер на телефоне с ядром 4.9 (Android 9): движок JavaScript
+     * Движок JavaScript правит собственный сгенерированный код (встроенные кэши вызовов), и
+     * первая же такая правка убивала процесс:
+     *
+     *   ПАДЕНИЕ ГОСТЯ: сигнал 11, поток "WebViewCoreThre"
+     *   PC = …/libbrowsercore.so + 0x3482b6      (инструкция `str r4, [r0, #8]`)
+     *   R0 = 0x45d72a74  [r--p]  гость: rwx  (запись закрыта НАМИ)
+     *
+     * На телефонах с новым ядром (ядро 6.x) ESR есть, и того же
+     * падения не бывает вовсе — оттого ошибка и выглядела «зависящей от
+     * телефона».
+     *
+     * Проверка безопасна: PAGE_WRITE_ORG без PAGE_WRITE бывает ТОЛЬКО у
+     * страниц, закрытых нами; чтение и исполнение на них не отказывают, потому
+     * что эти права мы не трогали.
+     */
+    if (!is_write && is_valid && info->si_code == SEGV_ACCERR) {
+        int gf = page_get_flags(guest_addr);
+
+        if ((gf & PAGE_WRITE_ORG) && !(gf & PAGE_WRITE)) {
+            is_write = true;
+        }
+    }
+
     MMUAccessType access_type = adjust_signal_pc(&pc, is_write);
     bool maperr;
 
