+        guest_selinux()) {
+        int nfd;
+
+        errno = EACCES;     /* подмену включает отказ по правам (guest_net.c) */
+        if (guest_net_socket_fallback(domain, type, protocol, &nfd)) {
+            return sock_flags_fixup(nfd, target_type);
+        }
+        return -TARGET_EACCES;
     }
 
