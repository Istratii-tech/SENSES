+        if (!q) {
+            return abs;
+        }
+        p = q + 1;
+    }
+    if (has_prefix(p, "root", &rest)) {
+        char *r = norm(*rest ? rest : "/");
+
+        g_free(abs);
+        return r;
+    }
+    if (has_prefix(p, "cwd", &rest)) {
+        char *dir = NULL, *j, *r;
+
+        if (self) {
+            dir = cwd_get();
+        } else {
+            char link[64], host[PATH_MAX];
+            ssize_t n;
+
+            snprintf(link, sizeof link, "/proc/%.*s/cwd", (int)wl, who);
+            n = readlink(link, host, sizeof host - 1);
+            if (n > 0) {
