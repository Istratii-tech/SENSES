+/* chdir гостя: настоящий каталог — в дерево, гостевой — запомнить. */
+int path_chdir(const char *name)
+{
+    char *abs;
+    int r;
+
+    if (!base || !name || name[0] == '\0') {
+        return chdir(name);
+    }
+    abs = absolute(name);
+    r = chdir(path(abs));
+    if (r == 0) {
