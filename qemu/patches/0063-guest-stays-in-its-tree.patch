+    if (sdcard_base && (has_prefix(host, sdcard_base, &rest) ||
+                        (sdcard_real && has_prefix(host, sdcard_real, &rest)))) {
+        return g_strconcat("/mnt/sdcard", rest, NULL);
+    }
+    return NULL;
