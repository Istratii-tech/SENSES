+/* Свести гостевой абсолютный путь: «.», «..», повторные «/»; выше «/» не выйти. */
+static char *norm(const char *abs)
+{
+    GString *out = g_string_new("");
+    const char *p = abs;
+
+    while (*p) {
+        const char *seg;
+        size_t len;
+
+        while (*p == '/') {
+            p++;
+        }
+        if (!*p) {
+            break;
+        }
+        seg = p;
+        while (*p && *p != '/') {
+            p++;
+        }
+        len = p - seg;
+        if (len == 1 && seg[0] == '.') {
+            continue;
+        }
+        if (len == 2 && seg[0] == '.' && seg[1] == '.') {
+            char *slash = strrchr(out->str, '/');
+
+            if (slash) {
