+ * в дерево; readlink отдаст гостю её обратно гостевой (path_link_to_guest).
+ */
+const char *path_link_target(const char *target)
+{
+    if (!base || !target || target[0] != '/') {
+        return target;
+    }
+    return path(target);
+}
