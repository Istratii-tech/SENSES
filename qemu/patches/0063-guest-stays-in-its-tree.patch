+
+static char *cwd_get(void)
+{
+    char *c;
+
+    qemu_mutex_lock(&cwd_lock);
+    c = g_strdup(guest_cwd ? guest_cwd : "/");
+    qemu_mutex_unlock(&cwd_lock);
+    return c;
