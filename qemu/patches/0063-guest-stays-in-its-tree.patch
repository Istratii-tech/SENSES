+/* Гостевой абсолютный путь для имени: относительное — от рабочего каталога гостя. */
+static char *absolute(const char *name)
+{
+    char *j, *r;
 
+    if (name[0] == '/') {
+        j = g_strdup(name);
+    } else {
+        char *c = cwd_get();
+
+        j = g_strconcat(c, "/", name, NULL);
+        g_free(c);
+    }
+    r = norm(j);
+    g_free(j);
+    return proc_links(r);
+}
