+/* Хозяйский путь → гостевой; NULL — он вне дерева и общей папки. */
+char *path_to_guest(const char *host)
+{
+    const char *rest;
+
+    if (!host || host[0] != '/') {
+        return NULL;
+    }
+    if (base && (has_prefix(host, base, &rest) ||
