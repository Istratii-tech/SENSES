+ */
+static bool is_clean(const char *s)
+{
+    const char *p;
+
+    if (s[0] != '/' || strncmp(s, "/proc/", 6) == 0) {
+        return false;
+    }
+    for (p = s; *p; p++) {
+        if (p[0] == '/' &&
