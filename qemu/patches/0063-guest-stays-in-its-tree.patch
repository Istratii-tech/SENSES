+static bool has_prefix(const char *s, const char *pre, const char **rest)
+{
+    size_t n = strlen(pre);
+
+    if (strncmp(s, pre, n) != 0 || (s[n] != '/' && s[n] != '\0')) {
+        return false;
+    }
+    if (rest) {
+        *rest = s + n;
+    }
+    return true;
