+
+static bool all_digits(const char *s, size_t n)
+{
+    size_t i;
+
+    for (i = 0; i < n; i++) {
+        if (!g_ascii_isdigit(s[i])) {
+            return false;
+        }
+    }
+    return n > 0;
+}
